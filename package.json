{
  "name": "aikon-role-manager",
  "version": "1.1.1",
  "main": "index.js",
  "scripts": {
    "wp:start": "wp-env start --xdebug",
    "wp:stop": "wp-env stop",
    "wp:test:start": "wp-env --config=.wp-env.tests.json start",
    "wp:test:stop": "wp-env --config=.wp-env.tests.json stop",
    "cli": "wp-env run cli",
    "composer": "wp-env run cli composer",
    "wps:start": "wp-scripts start assets/src/js/main.js --output-path=assets/build --watch",
    "wps:build": "wp-scripts build assets/src/js/main.js --output-path=assets/build",
    "wps:lint": "wp-scripts lint-js assets/src/js/main.js",
    "wps:format": "wp-scripts format ./assets/src",
    "zip": "wp-scripts plugin-zip",
    "test": "wp-env --config=.wp-env.tests.json run cli --env-cwd=/var/www/html/wp-content/plugins/aikon-role-manager vendor/bin/phpunit",
    "test:integration": "wp-env --config=.wp-env.tests.json run cli --env-cwd=/var/www/html/wp-content/plugins/aikon-role-manager vendor/bin/phpunit -c phpunit.integration.xml",
    "test:all": "npm run test && npm run test:integration"
  },
  "author": "Andreas Andersson",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@wordpress/env": "^11.14.0",
    "@wordpress/scripts": "^34.2.0"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.2",
    "@sentry/node": "10.73.0",
    "copy-webpack-plugin": {
      "serialize-javascript": "7.0.5"
    },
    "express": {
      "qs": "6.16.0"
    },
    "lighthouse": "13.4.1",
    "linkify-it": "6.1.0",
    "markdown-it": "15.0.1",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "minimatch": "10.2.5",
    "puppeteer-core": "25.10.0",
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "files": [
    "assets/build",
    "languages",
    "src",
    "templates",
    "vendor",
    "aikon-role-manager.php",
    "composer.json",
    "LICENCE",
    "readme.txt",
    "!README.md"
  ]
}
